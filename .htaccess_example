<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} ^(.*)/(js|css|resources|plugin|webfonts|config)/?$
    RewriteRule ^(js|css|resources|plugin|webfonts|config)/?$ %1/main.html [R=302,L,NC]

    ErrorDocument 404 /main.html
    ErrorDocument 403 /main.html

    # Evita listar directorios
    Options -Indexes
</IfModule>

